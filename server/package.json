{
  "name": "necro-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Necro backend: graveyard scanner, hourly voting rounds, pump bot and the website.",
  "scripts": {
    "start": "tsx src/index.ts all",
    "api": "tsx src/index.ts api",
    "worker": "tsx src/index.ts worker",
    "test": "node --experimental-strip-types --no-warnings --import ./test/register.mjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "retry": "tsx src/retry.ts"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "express": "^4.21.2",
    "viem": "^2.21.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}

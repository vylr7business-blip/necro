# Copy this to .env (or paste into your host's "Variables" page).
# Never commit the real .env. Never paste PUMP_PRIVATE_KEY into a chat.

PORT=8787
DB_PATH=./necro.db
CORS_ORIGIN=*
RPC_URL=https://rpc.mainnet.chain.robinhood.com

# The Necro dev wallet: launches $NECRO and collects its creator fees. Shown on the site. The server never holds its key.
NECRO_DEV_WALLET=0x5530772Ea031e749213EDc0414C0cB3c01a422DA

# Fill these in after $NECRO launches on pons (token address + launch block).
# Until then, voting runs in practice mode: one wallet, one vote.
NECRO_TOKEN=0x1beede8d71b816fa19f13041ebd273e1e9610c74
NECRO_START_BLOCK=81070539

# Secret key of the small PUMP wallet (a brand-new wallet, NOT the Necro dev wallet).
PUMP_PRIVATE_KEY=
# The bot only sends real buys when this is 1.
PUMPS_ENABLED=
# What happens to bought coins: burn (sent to the dead address) or hold (stay in the pump wallet)
AFTER_BUY=hold

# Pump size and safety rails
MAX_PUMP_ETH=0.5
MIN_PUMP_ETH=0.005
DAILY_PUMP_CAP_ETH=5
GAS_RESERVE_ETH=0.003
LOW_BALANCE_ETH=0.01
MAX_SLIPPAGE_BPS=300
PUMP_CHUNKS=5
CHUNK_SPACING_SEC=60

# Graveyard rules
MIN_PEAK_USD=10000
MIN_DROP_PCT=90
QUIET_VOL_24H_ETH=0.05
MIN_DEAD_DAYS=7
MIN_POOL_ETH=0.05
MAX_DEV_PCT=2
COOLDOWN_HOURS=24
BALLOT_SIZE=10
VOTE_LOCK_MINUTE=50

# Optional: a Discord or Slack webhook URL for alerts (low balance, failed buys)
ALERT_WEBHOOK_URL=

# Copy this into Railway's Variables page. Never commit real values. Never paste PUMP_PRIVATE_KEY into a chat.

PORT=8787
DB_PATH=/data/afterlife.db
CORS_ORIGIN=*

# A Solana RPC with real limits, e.g. Helius: https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=

# The wallet that launches $AFTER on pump.fun (gets the creator fees). Shown on the site.
DEV_WALLET=
# $AFTER's mint address, after launch. Until it's set, voting runs in practice mode (1 wallet = 1 vote).
AFTER_MINT=

# Secret key of a brand-new PUMP wallet (Phantom → Settings → Show private key). NOT the dev wallet.
PUMP_PRIVATE_KEY=
# The bot only sends real buys when this is 1.
PUMPS_ENABLED=
# burn = bought tokens are burned on-chain. hold = they stay in the pump wallet.
AFTER_BUY=burn

# Pump size and safety rails
MAX_PUMP_SOL=2
MIN_PUMP_SOL=0.02
DAILY_PUMP_CAP_SOL=20
SOL_RESERVE=0.02
MAX_SLIPPAGE_BPS=300
PUMP_CHUNKS=5
CHUNK_SPACING_SEC=60

# Graveyard rules
MIN_ATH_USD=60000
MIN_DROP_PCT=90
QUIET_VOL_24H_USD=2000
MIN_DEAD_DAYS=7
MIN_POOL_SOL=1
MAX_DEV_PCT=2
COOLDOWN_HOURS=24
BALLOT_SIZE=10
VOTE_LOCK_MINUTE=50

# Optional: Discord or Slack webhook for alerts
ALERT_WEBHOOK_URL=
